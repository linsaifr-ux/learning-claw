# Copy to .env.local. Firebase web configuration is public; never put Gemini keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=

# Free external Node backend, e.g. your Render Free URL. Never put credentials here.
VITE_BACKEND_URL=
